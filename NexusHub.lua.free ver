--==================================================
-- ANTI AFK - ORIGINAL LOGIC
--==================================================

local function SetAntiAFK(state)
	AntiAFK=state
	SavedState.AntiAFK=state

	if state then
		if afkLoop then task.cancel(afkLoop) end

		afkLoop=task.spawn(function()
			while AntiAFK do
				pcall(function()
					local char=LP.Character
					local hrp=char and char:FindFirstChild("HumanoidRootPart")

					if hrp then
						hrp.CFrame=hrp.CFrame*CFrame.new(0,0.01,0)
						task.wait(0.1)
						hrp.CFrame=hrp.CFrame*CFrame.new(0,-0.01,0)
					end
				end)

				task.wait(15)
			end
		end)
	else
		if afkLoop then
			task.cancel(afkLoop)
			afkLoop=nil
		end
	end
end

--==================================================
-- AUTO RECONNECT
--==================================================

local function ClearReconnectConnections()
	for _,c in ipairs(ReconnectConnections) do
		pcall(function()
			c:Disconnect()
		end)
	end
	table.clear(ReconnectConnections)
end

local function safeTeleport()
	if reconnectBusy or not AutoReconnect then return end

	reconnectBusy=true

	task.spawn(function()
		while AutoReconnect do
			local success,err=pcall(function()
				TeleportService:Teleport(game.PlaceId,LP)
			end)

			if success then
				break
			end

			warn("[Nexus Hub] Teleport failed, retrying in 5s: "..tostring(err))
			task.wait(5)
		end

		reconnectBusy=false
	end)
end

local function ConnectErrorPrompt()
	local robloxGui=CoreGui:FindFirstChild("RobloxGui")
	if not robloxGui then return false end

	local errorPrompt=robloxGui:FindFirstChild("ErrorPrompt",true)
	if not errorPrompt then return false end

	local conn=errorPrompt:GetPropertyChangedSignal("Visible"):Connect(function()
		if AutoReconnect and errorPrompt.Visible then
			task.delay(2,function()
				if AutoReconnect then
					safeTeleport()
				end
			end)
		end
	end)

	table.insert(ReconnectConnections,conn)
	return true
end

local function ConnectGuiService()
	local conn=game:GetService("GuiService").ErrorMessageChanged:Connect(function(message)
		if AutoReconnect and message and message~="" then
			task.delay(2,function()
				if AutoReconnect then
					safeTeleport()
				end
			end)
		end
	end)

	table.insert(ReconnectConnections,conn)
end

local function SetAutoReconnect(state)
	AutoReconnect=state
	SavedState.AutoReconnect=state

	ClearReconnectConnections()
	reconnectBusy=false

	if not state then return end

	ConnectGuiService()

	task.spawn(function()
		for _=1,20 do
			if not AutoReconnect then return end

			if ConnectErrorPrompt() then
				break
			end

			task.wait(.5)
		end
	end)
end

