--// DRAWER STATE

local DrawerOpen=false
local DrawerTweening=false

local DrawerTweenInfo=TweenInfo.new(
.22,
Enum.EasingStyle.Quad,
Enum.EasingDirection.Out
)

--// OPEN

local function OpenDrawer()

if DrawerTweening or DrawerOpen then
return
end

DrawerTweening=true
DrawerOpen=true

Drawer.Visible=true

-- Start outside.
Drawer.Position=DrawerClosedPosition

-- Select Pets shrinks to the free space.
TweenService:Create(
SelectPets,
DrawerTweenInfo,
{
Size=SelectOpenSize
}
):Play()

-- Short text so it doesn't get covered.
SelectPets.Text="Pets"

local DrawerTween=TweenService:Create(
Drawer,
DrawerTweenInfo,
{
Position=DrawerOpenPosition
}
)

DrawerTween:Play()

DrawerTween.Completed:Connect(function()
DrawerTweening=false
end)

end

--// CLOSE

local function CloseDrawer()

if DrawerTweening or not DrawerOpen then
return
end

DrawerTweening=true
DrawerOpen=false

-- Restore original button.
TweenService:Create(
SelectPets,
DrawerTweenInfo,
{
Size=SelectClosedSize
}
):Play()

SelectPets.Text="Select Pets"

-- Slide drawer back out.
local DrawerTween=TweenService:Create(
Drawer,
DrawerTweenInfo,
{
Position=DrawerClosedPosition
}
)

DrawerTween:Play()

DrawerTween.Completed:Connect(function()

DrawerTweening=false

if not DrawerOpen then
Drawer.Visible=false
end

end)

end

--// SELECT PETS TOGGLE

SelectPets.MouseButton1Click:Connect(function()

