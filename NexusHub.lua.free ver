Corner(knob,8)

local drag=false

local function update(i)
local n=math.clamp((i.Position.X-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1)
value=n*max
v.Text=string.format("%.1f",value)
fill.Size=UDim2.new(n,0,1,0)
knob.Position=UDim2.new(n,0,.5,0)
return value
end

