	sub.TextXAlignment=Enum.TextXAlignment.Left

	local sw=Instance.new("Frame",b)
	sw.Size=UDim2.fromOffset(42,21)
	sw.Position=UDim2.new(1,-52,.5,-10)
	sw.BackgroundColor3=Color3.fromRGB(38,27,44)
	sw.BorderSizePixel=0
	Instance.new("UICorner",sw).CornerRadius=UDim.new(1,0)

	local swStroke=Instance.new("UIStroke",sw)
	swStroke.Color=C.purple
	swStroke.Transparency=.65

	local knob=Instance.new("Frame",sw)
	knob.Size=UDim2.fromOffset(15,15)
	knob.Position=UDim2.fromOffset(3,3)
	knob.BackgroundColor3=C.gray
	knob.BorderSizePixel=0
	Instance.new("UICorner",knob).CornerRadius=UDim.new(1,0)

	local value=state

	local function update(v)
		value=v

		if v then
			tw(sw,{BackgroundColor3=C.crimson},.16)
			tw(knob,{Position=UDim2.fromOffset(24,3),BackgroundColor3=C.white},.18)
		else
			tw(sw,{BackgroundColor3=Color3.fromRGB(38,27,44)},.16)
			tw(knob,{Position=UDim2.fromOffset(3,3),BackgroundColor3=C.gray},.18)
		end

		if callback then callback(v) end
	end

	b.MouseEnter:Connect(function()
		tw(b,{BackgroundColor3=Color3.fromRGB(36,21,45)},.12)
	end)

	b.MouseLeave:Connect(function()
		tw(b,{BackgroundColor3=C.panel2},.12)
	end)

	b.MouseButton1Click:Connect(function()
		update(not value)
	end)

	task.defer(function()
		if state then
			update(true)
		end
	end)

	return b,update
end

